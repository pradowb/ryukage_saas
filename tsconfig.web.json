{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom"],
    "allowImportingTsExtensions": false,
    "noEmit": true
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "shared/**/*.ts"]
}
