# Copie para .env e ajuste. Nunca faça commit do .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3847
LOG_LEVEL=info

# Postgres. Se ficar vazio, usa uma base embutida (PGlite) em PGLITE_DIR — só para desenvolvimento.
DATABASE_URL=
# DATABASE_URL=postgres://ryukage:ryukage@localhost:5432/ryukage
PGLITE_DIR=./data/pglite

# Sessões
SESSION_TTL_HOURS=12
# true em produção (HTTPS). Em desenvolvimento local (http) deve ser false.
COOKIE_SECURE=false
# Defina true quando estiver atrás de um proxy reverso (Easypanel, Nginx, Traefik).
TRUST_PROXY=false

# Usado apenas pelo `npm run db:seed`. Em produção cria só as contas (sem dados de demonstração).
SEED_RESTAURANTE_NOME=La Bella
SEED_RESTAURANTE_CIDADE=Matosinhos
SEED_ADMIN_EMAIL=dono@labella.pt
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_EQUIPE_EMAIL=cozinha@labella.pt
SEED_EQUIPE_PASSWORD=troque-esta-senha-tambem
